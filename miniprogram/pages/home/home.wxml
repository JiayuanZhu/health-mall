<view class="home-page">
  <!-- 搜索栏 -->
  <view class="home-search" bindtap="goToProducts">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索药品、科室...</text>
    </view>
  </view>

  <!-- 轮播图 -->
  <view class="banner-section" wx:if="{{banners.length > 0}}">
    <swiper class="banner-swiper"
      indicator-dots="{{true}}"
      indicator-color="rgba(255,255,255,0.5)"
      indicator-active-color="#ffffff"
      autoplay="{{true}}"
      interval="{{4000}}"
      circular="{{true}}">
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-banner="{{item}}">
        <image class="banner-image" src="{{item.image_url}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
  </view>

  <!-- 默认轮播占位 -->
  <view class="banner-section" wx:if="{{banners.length === 0 && !loading}}">
    <view class="banner-placeholder">
      <text class="banner-placeholder-icon">🏥</text>
      <text class="banner-placeholder-text">健康商城 · 您的健康管家</text>
    </view>
  </view>

  <!-- 服务功能 -->
  <view class="services-section">
    <view class="services-grid">
      <view class="service-item" wx:for="{{services}}" wx:key="name">
        <view class="service-icon-wrap">
          <text class="service-icon">{{item.icon}}</text>
        </view>
        <text class="service-name">{{item.name}}</text>
        <text class="service-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 药品分类 -->
  <view class="section" wx:if="{{categories.length > 0}}">
    <view class="section-header">
      <text class="section-title">药品分类</text>
      <text class="section-more" bindtap="goToProducts">查看全部 ›</text>
    </view>
    <view class="category-grid">
      <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="onCategoryTap" data-category="{{item}}">
        <view class="category-icon-wrap">
          <text class="category-icon">{{item.icon || '💊'}}</text>
        </view>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 热门药品 -->
  <view class="section" wx:if="{{hotProducts.length > 0}}">
    <view class="section-header">
      <text class="section-title">🔥 热门药品</text>
      <text class="section-more" bindtap="goToProducts">更多 ›</text>
    </view>
    <scroll-view class="hot-products-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="hot-products-list">
        <view class="hot-product-card" wx:for="{{hotProducts}}" wx:key="id" bindtap="onProductTap" data-id="{{item.id}}">
          <image class="hot-product-image" src="{{item.image_url}}" mode="aspectFill" />
          <view class="hot-product-info">
            <text class="hot-product-name">{{item.name}}</text>
            <text class="hot-product-spec">{{item.specification || ''}}</text>
            <view class="hot-product-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 热门科室 -->
  <view class="section" wx:if="{{hotDepartments.length > 0}}">
    <view class="section-header">
      <text class="section-title">🏥 热门科室</text>
      <text class="section-more" bindtap="goToDepartments">更多 ›</text>
    </view>
    <view class="dept-grid">
      <view class="dept-card" wx:for="{{hotDepartments}}" wx:key="id" bindtap="onDepartmentTap" data-id="{{item.id}}">
        <view class="dept-icon-wrap">
          <text class="dept-icon">{{item.icon || '🏥'}}</text>
        </view>
        <view class="dept-info">
          <text class="dept-name">{{item.name}}</text>
          <text class="dept-desc">{{item.description || '专业医疗服务'}}</text>
        </view>
        <text class="dept-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
