.departments-page {
  padding: 0 24rpx 24rpx;
}

/* 页面标题 */
.page-header {
  padding: 30rpx 0;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #9ca3af;
  display: block;
}

/* 科室列表 */
.dept-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dept-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.dept-card-left {
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dept-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ecfdf5, #d1fae5);
  border-radius: 20rpx;
}

.dept-icon-wrap.hot {
  background: linear-gradient(135deg, #fef2f2, #fecaca);
}

.dept-icon {
  font-size: 44rpx;
}

.dept-card-center {
  flex: 1;
  min-width: 0;
}

.dept-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.dept-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-right: 12rpx;
}

.hot-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  background: #fef2f2;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #ef4444;
}

.dept-desc {
  font-size: 24rpx;
  color: #6b7280;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dept-card-right {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.dept-arrow {
  font-size: 40rpx;
  color: #d1d5db;
}
