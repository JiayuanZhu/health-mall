<view class="profile-page">
  <!-- 用户信息区域 -->
  <view class="user-section">
    <view class="user-bg"></view>
    <view class="user-card" wx:if="{{isLoggedIn && userInfo}}">
      <view class="avatar-wrap">
        <text class="avatar-text">{{userInfo.name ? userInfo.name[0] : '👤'}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.name || userInfo.username}}</text>
        <text class="user-phone">{{userInfo.phone || ''}}</text>
      </view>
    </view>
    <view class="user-card guest" wx:else>
      <view class="avatar-wrap guest">
        <text class="avatar-text">👤</text>
      </view>
      <view class="user-info">
        <text class="user-name">未登录</text>
        <view class="auth-btns">
          <view class="auth-btn login" bindtap="goToLogin">登录</view>
          <view class="auth-btn register" bindtap="goToRegister">注册</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-card">
      <view class="menu-item" wx:for="{{menuItems}}" wx:key="title" bindtap="onMenuTap" data-url="{{item.url}}">
        <view class="menu-left">
          <text class="menu-icon">{{item.icon}}</text>
          <text class="menu-title">{{item.title}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <view class="logout-btn" bindtap="onLogout">
      <text>退出登录</text>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <text class="footer-text">健康商城 v1.0.0</text>
  </view>
</view>
