.product-detail-page {
  padding-bottom: 160rpx;
}

/* 商品图片 */
.product-image-section {
  width: 100%;
  height: 500rpx;
  background: #ffffff;
}

.product-main-image {
  width: 100%;
  height: 100%;
}

/* 价格 */
.product-price-section {
  background: linear-gradient(135deg, #fef2f2, #ffffff);
  padding: 24rpx 30rpx;
  margin: 0 24rpx;
  margin-top: -20rpx;
  border-radius: 16rpx;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.1);
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-right: 16rpx;
}

.price-display {
  color: #ef4444;
  font-weight: bold;
}

.price-display .price-symbol {
  font-size: 28rpx;
}

.price-display .price-value {
  font-size: 48rpx;
}

/* 商品信息 */
.product-info-section {
  background: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.product-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  line-height: 1.5;
  display: block;
  margin-bottom: 16rpx;
}

.product-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #fef2f2;
  color: #ef4444;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag.new {
  background: #ecfdf5;
  color: #10b981;
}

.info-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #6b7280;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #1a1a1a;
  flex: 1;
}

/* 商品描述 */
.product-desc-section {
  background: #ffffff;
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.product-desc-section .section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  display: block;
}

.product-description {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.quantity-section {
  display: flex;
  align-items: center;
}

.quantity-label {
  font-size: 26rpx;
  color: #6b7280;
  margin-right: 16rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
  background: #f3f4f6;
  border-radius: 8rpx;
  overflow: hidden;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #374151;
  font-weight: bold;
}

.qty-btn.disabled {
  color: #d1d5db;
}

.qty-btn.minus {
  background: #e5e7eb;
}

.qty-btn.plus {
  background: #e5e7eb;
}

.qty-value {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btns {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.btn-cart {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 50%;
  font-size: 36rpx;
}

.btn-add {
  padding: 18rpx 44rpx;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
}
