<view class="register-page">
  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo-icon">
      <text>🏥</text>
    </view>
    <text class="logo-title">创建账号</text>
    <text class="logo-subtitle">注册享受健康服务</text>
  </view>

  <!-- 注册表单 -->
  <view class="form-section">
    <view class="form-card">
      <view class="form-group">
        <view class="input-wrap">
          <text class="input-icon">👤</text>
          <input class="form-input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />
        </view>
      </view>
      <view class="form-group">
        <view class="input-wrap">
          <text class="input-icon">📝</text>
          <input class="form-input" placeholder="请输入姓名" value="{{name}}" bindinput="onNameInput" />
        </view>
      </view>
      <view class="form-group">
        <view class="input-wrap">
          <text class="input-icon">📱</text>
          <input class="form-input" placeholder="请输入手机号" type="number" value="{{phone}}" bindinput="onPhoneInput" />
        </view>
      </view>
      <view class="form-group">
        <view class="input-wrap">
          <text class="input-icon">🔒</text>
          <input class="form-input" placeholder="请输入密码（至少6位）" password="{{true}}" value="{{password}}" bindinput="onPasswordInput" />
        </view>
      </view>
      <view class="form-group">
        <view class="input-wrap">
          <text class="input-icon">🔒</text>
          <input class="form-input" placeholder="请确认密码" password="{{true}}" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
        </view>
      </view>

      <view class="register-btn {{loading ? 'disabled' : ''}}" bindtap="onRegister">
        <text>{{loading ? '注册中...' : '注册'}}</text>
      </view>

      <view class="login-link" bindtap="goToLogin">
        <text>已有账号？</text>
        <text class="link-text">去登录</text>
      </view>
    </view>
  </view>
</view>
