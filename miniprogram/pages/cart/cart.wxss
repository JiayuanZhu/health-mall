.cart-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 购物车头部 */
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.cart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.clear-btn {
  font-size: 26rpx;
  color: #ef4444;
}

/* 购物车项 */
.cart-list {
  padding: 0 24rpx;
}

.cart-item {
  background: #ffffff;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.cart-item:last-child {
  border-radius: 0 0 16rpx 16rpx;
  border-bottom: none;
}

.cart-item-content {
  display: flex;
  margin-bottom: 16rpx;
}

.cart-item-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.cart-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cart-item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cart-item-spec {
  font-size: 22rpx;
  color: #9ca3af;
}

.cart-item-price {
  color: #ef4444;
  font-weight: bold;
}

.cart-item-price .price-symbol {
  font-size: 22rpx;
}

.cart-item-price .price-value {
  font-size: 32rpx;
}

.cart-item-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity-control {
  display: flex;
  align-items: center;
  background: #f3f4f6;
  border-radius: 8rpx;
  overflow: hidden;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #374151;
  font-weight: bold;
  background: #e5e7eb;
}

.qty-value {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.remove-btn {
  font-size: 32rpx;
  padding: 8rpx;
}

/* 空购物车 */
.empty-btn {
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 28rpx;
}

/* 结算表单 */
.checkout-form {
  margin: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.form-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.form-close {
  font-size: 26rpx;
  color: #0ea5e9;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f8f9fa;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  background: #f8f9fa;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  height: 160rpx;
  box-sizing: border-box;
}

.form-submit {
  margin-top: 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  color: #ffffff;
  text-align: center;
  padding: 24rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.submit-btn.disabled {
  opacity: 0.6;
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.total-section {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #6b7280;
}

.total-price {
  color: #ef4444;
  font-weight: bold;
}

.total-price .price-symbol {
  font-size: 26rpx;
}

.total-price .price-value {
  font-size: 40rpx;
}

.checkout-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}
