<view class="cart-page">
  <!-- 购物车列表 -->
  <view class="cart-list" wx:if="{{cartItems.length > 0}}">
    <!-- 头部 -->
    <view class="cart-header">
      <text class="cart-title">🛒 购物车（{{cartItems.length}}）</text>
      <text class="clear-btn" bindtap="onClearCart">清空</text>
    </view>

    <!-- 商品项 -->
    <view class="cart-item" wx:for="{{cartItems}}" wx:key="id">
      <view class="cart-item-content" bindtap="onProductTap" data-product-id="{{item.product_id}}">
        <image class="cart-item-image" src="{{item.image_url || item.product_image}}" mode="aspectFill" />
        <view class="cart-item-info">
          <text class="cart-item-name">{{item.product_name || item.name}}</text>
          <text class="cart-item-spec">{{item.specification || ''}}</text>
          <view class="cart-item-price">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{item.price || item.product_price}}</text>
          </view>
        </view>
      </view>
      <view class="cart-item-actions">
        <view class="quantity-control">
          <view class="qty-btn" catchtap="onQuantityMinus" data-item="{{item}}">
            <text>-</text>
          </view>
          <text class="qty-value">{{item.quantity}}</text>
          <view class="qty-btn" catchtap="onQuantityPlus" data-item="{{item}}">
            <text>+</text>
          </view>
        </view>
        <view class="remove-btn" catchtap="onRemoveItem" data-item="{{item}}">
          <text>🗑️</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空购物车 -->
  <view class="empty-state" wx:if="{{!loading && cartItems.length === 0}}">
    <text class="empty-icon">🛒</text>
    <text class="empty-text">购物车是空的</text>
    <navigator url="/pages/products/products" open-type="switchTab" class="empty-btn">
      <text>去逛逛</text>
    </navigator>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 结算表单 -->
  <view class="checkout-form" wx:if="{{showCheckout}}">
    <view class="form-header">
      <text class="form-title">📦 填写收货信息</text>
      <text class="form-close" bindtap="toggleCheckout">收起</text>
    </view>

    <view class="form-group">
      <text class="form-label">收货人姓名</text>
      <input class="form-input" placeholder="请输入姓名" value="{{name}}" bindinput="onNameInput" />
    </view>

    <view class="form-group">
      <text class="form-label">联系电话</text>
      <input class="form-input" placeholder="请输入电话" type="number" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="form-group">
      <text class="form-label">收货地址</text>
      <textarea class="form-textarea" placeholder="请输入详细地址" value="{{address}}" bindinput="onAddressInput" maxlength="200" />
    </view>

    <view class="form-group">
      <text class="form-label">备注（选填）</text>
      <input class="form-input" placeholder="如有特殊要求请备注" value="{{remark}}" bindinput="onRemarkInput" />
    </view>

    <view class="form-submit">
      <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmitOrder">
        <text>{{submitting ? '提交中...' : '确认下单 ¥' + totalPrice}}</text>
      </view>
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view class="bottom-bar" wx:if="{{cartItems.length > 0 && !showCheckout}}">
    <view class="total-section">
      <text class="total-label">合计：</text>
      <view class="total-price">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{totalPrice}}</text>
      </view>
    </view>
    <view class="checkout-btn" bindtap="toggleCheckout">
      <text>去结算</text>
    </view>
  </view>
</view>
