<view class="orders-page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">📦 我的订单</text>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="onOrderTap" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">订单号：{{item.id}}</text>
        <view class="status-badge badge-{{item.status === 'pending' ? 'pending' : item.status === 'confirmed' ? 'confirmed' : item.status === 'completed' ? 'completed' : item.status === 'cancelled' ? 'cancelled' : 'pending'}}">
          <text>{{item.status === 'pending' ? '待处理' : item.status === 'confirmed' ? '已确认' : item.status === 'shipped' ? '已发货' : item.status === 'completed' ? '已完成' : item.status === 'cancelled' ? '已取消' : item.status}}</text>
        </view>
      </view>

      <!-- 订单商品 -->
      <view class="order-items" wx:if="{{item.items && item.items.length > 0}}">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="product" wx:key="id">
          <image class="order-item-image" src="{{product.image_url || product.product_image}}" mode="aspectFill" />
          <view class="order-item-info">
            <text class="order-item-name">{{product.product_name || product.name}}</text>
            <text class="order-item-qty">x{{product.quantity}}</text>
          </view>
          <text class="order-item-price">¥{{product.price || product.product_price}}</text>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <view class="order-info">
          <text class="order-total" wx:if="{{item.total_amount}}">合计：¥{{item.total_amount}}</text>
          <text class="order-date">{{item.created_at || ''}}</text>
        </view>
        <view class="order-actions">
          <view class="cancel-btn" wx:if="{{item.status === 'pending'}}" catchtap="onCancelOrder" data-order="{{item}}">
            <text>取消订单</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">
    <text class="empty-icon">📦</text>
    <text class="empty-text">暂无订单</text>
    <navigator url="/pages/products/products" open-type="switchTab" class="empty-btn">
      <text>去购物</text>
    </navigator>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
