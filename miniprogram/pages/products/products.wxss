.products-page {
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-section {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  gap: 16rpx;
}

.search-section .search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-section .search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-section .search-input {
  flex: 1;
  font-size: 28rpx;
}

.cart-btn {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  font-size: 36rpx;
}

/* 分类筛选 */
.category-scroll {
  background: #ffffff;
  padding: 20rpx 0;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.category-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #f3f4f6;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #4b5563;
  white-space: nowrap;
}

.category-tag.active {
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  color: #ffffff;
  font-weight: 500;
}

/* 药品网格 */
.products-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 16rpx;
  gap: 16rpx;
}

.product-card {
  width: calc(50% - 8rpx);
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.product-image {
  width: 100%;
  height: 280rpx;
  background: #f3f4f6;
}

.product-info {
  padding: 16rpx 20rpx;
}

.product-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a1a;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.product-spec {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
  display: block;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  color: #ef4444;
  font-weight: bold;
}

.product-price .price-symbol {
  font-size: 22rpx;
}

.product-price .price-value {
  font-size: 34rpx;
}

.add-cart-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  border-radius: 50%;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20rpx;
  color: #9ca3af;
  font-size: 24rpx;
}
