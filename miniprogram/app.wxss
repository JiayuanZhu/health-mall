/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 通用工具类 */
.container {
  padding: 20rpx 24rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 标题 */
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-left: 12rpx;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  color: #ffffff;
  border: none;
  border-radius: 44rpx;
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
  font-weight: 500;
}

.btn-primary::after {
  border: none;
}

.btn-success {
  background: linear-gradient(135deg, #10b981, #34d399);
  color: #ffffff;
  border: none;
  border-radius: 44rpx;
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
  font-weight: 500;
}

.btn-success::after {
  border: none;
}

.btn-outline {
  background: #ffffff;
  color: #0ea5e9;
  border: 2rpx solid #0ea5e9;
  border-radius: 44rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-outline::after {
  border: none;
}

.btn-danger {
  background: linear-gradient(135deg, #ef4444, #f87171);
  color: #ffffff;
  border: none;
  border-radius: 44rpx;
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-danger::after {
  border: none;
}

/* 价格 */
.price {
  color: #ef4444;
  font-weight: bold;
}

.price-symbol {
  font-size: 24rpx;
}

.price-value {
  font-size: 36rpx;
}

/* 徽章 */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.badge-hot {
  background-color: #fef2f2;
  color: #ef4444;
}

.badge-new {
  background-color: #f0fdf4;
  color: #10b981;
}

.badge-pending {
  background-color: #fef3c7;
  color: #d97706;
}

.badge-confirmed {
  background-color: #dbeafe;
  color: #2563eb;
}

.badge-completed {
  background-color: #d1fae5;
  color: #059669;
}

.badge-cancelled {
  background-color: #f3f4f6;
  color: #6b7280;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 20rpx 0;
}

/* 输入框 */
.input-field {
  background: #f8f9fa;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.input-field:focus {
  border-color: #0ea5e9;
}

/* 标签 */
.label {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 500;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  color: #9ca3af;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}
